<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Create Password — Tibyan Medresa</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;padding:20px;
  font-family:Arial,sans-serif;
  background:#F7F0E4;color:#4A2C20;
}
main{max-width:480px;margin:35px auto}
.panel{
  background:white;padding:25px;border-radius:16px;
  box-shadow:0 5px 22px #00000012;
}
h1,h2{text-align:center}
p{line-height:1.6}
.logo-placeholder{
  width:85px;height:85px;margin:0 auto 12px;
  display:flex;align-items:center;justify-content:center;
  border:1px dashed #b7a58d;border-radius:50%;
  color:#88765e;font-size:12px;text-align:center;
}
.male-theme{background:#EAF4FF}
.female-theme{background:#FFF0F6}
label{display:block;margin-top:17px;font-weight:bold}
input{
  width:100%;padding:12px;margin-top:7px;
  border:1px solid #c9b89d;border-radius:7px;
  font-size:16px;background:white;
}
button{
  width:100%;margin-top:22px;padding:14px;
  border:0;border-radius:8px;color:white;
  font-size:16px;font-weight:bold;cursor:pointer;
  background:#3478B9;
}
.female-theme button{background:#C34D87}
button:disabled{opacity:.6;cursor:not-allowed}
.small{font-size:13px;color:#65594b}
#message{overflow-wrap:anywhere}
</style>
</head>

<body>
<main>
<section id="panel" class="panel">
  <div class="logo-placeholder">Tibyan logo</div>
  <h1>ቲብያን መድረሳ</h1>
  <h2>Create Your Password</h2>
  <p id="intro">Your email confirmation is being checked...</p>

  <form id="passwordForm" hidden>
    <label for="studentCode">Your student username</label>
    <input id="studentCode" readonly>

    <label for="password">Create password</label>
    <input id="password" type="password"
           minlength="8" autocomplete="new-password"
           placeholder="At least 8 characters" required>

    <label for="confirmPassword">Confirm password</label>
    <input id="confirmPassword" type="password"
           minlength="8" autocomplete="new-password"
           placeholder="Enter password again" required>

    <button id="saveButton" type="submit">Save Password</button>
  </form>

  <p id="message" role="status" aria-live="polite"></p>
  <p class="small">Keep your student code and password safe.</p>
</section>
</main>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
const SUPABASE_URL = "https://vldyuegaoptahhlsldor.supabase.co";
const SUPABASE_KEY = "sb_publishable_3NKxWzGph0mviWRGENEPYw_puAh7dxj";

const supabase = window.supabase.createClient(
  SUPABASE_URL,
  SUPABASE_KEY
);

const panel = document.getElementById("panel");
const intro = document.getElementById("intro");
const form = document.getElementById("passwordForm");
const message = document.getElementById("message");
const saveButton = document.getElementById("saveButton");

let studentEmail = "";

async function initialize() {
  const { data, error } = await supabase.auth.getSession();

  if (error || !data.session) {
    intro.textContent =
      "This confirmation session is missing or expired. Please use the latest confirmation email.";
    return;
  }

  const user = data.session.user;

  if (!user.email || !user.email_confirmed_at) {
    intro.textContent =
      "Please confirm your email before creating a password.";
    return;
  }

  studentEmail = user.email;

  const { data: registrations, error: lookupError } = await supabase
    .from("student_registrations")
    .select("student_code, gender")
    .eq("email", studentEmail)
    .eq("verification_status", "verified")
    .not("student_code", "is", null)
    .limit(1);

  if (lookupError || !registrations || !registrations.length) {
    intro.textContent =
      "Your email is confirmed, but we couldn't retrieve your student code. Please contact the administrator.";
    return;
  }

  const student = registrations[0];

  document.getElementById("studentCode").value =
    student.student_code;

  panel.classList.add(
    student.gender === "female" ? "female-theme" : "male-theme"
  );

  intro.textContent =
    "Your email is confirmed. Create a password for your account.";
  form.hidden = false;
}

form.addEventListener("submit", async function(event) {
  event.preventDefault();
  message.textContent = "";

  const password = document.getElementById("password").value;
  const confirmation =
    document.getElementById("confirmPassword").value;

  if (password.length < 8) {
    message.textContent =
      "Your password must contain at least 8 characters.";
    return;
  }

  if (password !== confirmation) {
    message.textContent = "The passwords do not match.";
    return;
  }

  saveButton.disabled = true;
  saveButton.textContent = "Saving...";

  try {
    const { error } = await supabase.auth.updateUser({
      password: password
    });

    if (error) throw error;

    message.textContent =
      "Password created successfully! Your username is " +
      document.getElementById("studentCode").value +
      ". You can now sign in using your student code and password.";

    form.reset();
    form.hidden = true;
    intro.textContent = "Your account password has been created.";
  } catch (error) {
    message.textContent = error.message;
  } finally {
    saveButton.disabled = false;
    saveButton.textContent = "Save Password";
  }
});

initialize();
</script>
</body>
</html>
